# Copy to .env and fill in. Never commit .env.

# Arbitrum Sepolia (testnet). Swap for any Arbitrum chain RPC, e.g. Robinhood Chain.
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Chain id of RPC_URL (421614 = Arbitrum Sepolia, 412346 = local dev node). Used by the optional client/.
CHAIN_ID=421614

# Deployer key (0x-prefixed hex). Use a throwaway testnet wallet funded from a faucet.
PRIVATE_KEY=

# Address of your deployed contract (used by the optional client/ created with --with-client).
CONTRACT_ADDRESS=
